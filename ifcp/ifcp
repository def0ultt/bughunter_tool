            if is_hit:
                hit_badge = style.badge_cache_hit()
            elif "CPDoS" in issue_type:
                hit_badge = style.badge_cpdos()
            else:
                hit_badge = style.badge_reflect()

            # Render Card
            card_title = f" {sev_badge} {title_color(style.bold(issue_type))} via {style.bold(header)} "
            card_line_len = 80 - len(f"┌── {issue_type} via {header} ")
            print(f"┌──{card_title}{'─' * max(2, card_line_len)}")
            print(f"│ {style.dim('Type      :')} {title_color(issue_type)} {style.dim(f'(Severity: {severity})')}  {hit_badge}")
            print(f"│ {style.dim('Header    :')} {style.bold(header)}: {style.cyan(payload)}")
            print(f"│ {style.dim('Strategy  :')} {style.yellow(strategy)}")

            if status_code:
                status_str = f"HTTP {status_code}"
                if item.get("content_length"):
                    status_str += f" ({item['content_length']:,} bytes)"
                print(f"│ {style.dim('Response  :')} {status_str}")

            if "CPDoS" in issue_type:
                print(f"│ {style.dim('Flow      :')} {details}")
                if "verify_url" in item:
                    print(f"│ {style.dim('Verify URL:')} {item['verify_url']}")
            else:
                print(f"│ {style.dim('Evidence  :')} {details}")
                print(f"│ {style.dim('Cache Info:')} {cache_evid}")

            print(f"│ {style.dim('Base URL  :')} {base_url}")
            print(f"│ {style.dim('Probe URL :')} {style.dim(probe_url)}")
            print(f"└{'─' * 79}\n")

    # Render Executive Summary Report
    print(style.cyan("═" * 80))
    print(style.bold(style.cyan("                            SCAN SUMMARY REPORT                            ")))
    print(style.cyan("═" * 80))
    print(f"  {style.bold('URLs Tested            :')} {tested_count}")
    print(f"  {style.bold('Unique Target Hosts    :')} {len(grouped_by_target)}")
    print(f"  {style.bold('Total Findings         :')} {len(all_grouped)}")
    print(f"    • {style.red(style.bold('High Severity (Cache Hit)'))} : {sev_counts['HIGH']}")
    print(f"    • {style.yellow(style.bold('Medium Severity          '))} : {sev_counts['MEDIUM']}")
    print(f"    • {style.blue(style.bold('Low Severity (Reflection)'))} : {sev_counts['LOW']}")
    print(style.dim("─" * 80))
    print(f"  {style.bold('Vulnerability Categories:')}")
    print(f"    • Cache Poisoning        : {total_cp}")
    print(f"    • URL Normalization CPDoS: {total_cpdos}")
    print(f"    • Header Reflection Only : {total_hr}")

    if header_counts:
        print(style.dim("─" * 80))
        print(f"  {style.bold('Top Headers Reflected / Poisoned:')}")
        for hdr, count in header_counts.most_common(8):
            print(f"    • {style.cyan(hdr.ljust(25))} : {count} occurrence(s)")

    print(style.cyan("═" * 80))


# ─── Entry Point ──────────────────────────────────────────────────────────────

def main():
    args      = parse_args()
    headers   = parse_headers(args.headers)
    use_color = not args.no_color
    style     = Style(enabled=use_color)
    session   = requests.Session()

    # Show banner in interactive mode unless suppressed or in quiet/json mode
    if not args.no_banner and not args.quiet and not args.json and sys.stderr.isatty():
        print_banner(style)

    # Load custom header wordlist if provided
    custom_headers = None
    if args.wordlist:
        try:
            with open(args.wordlist, 'r') as f:
                raw_headers = [line.strip() for line in f if line.strip() and not line.startswith('#')]
            valid_re = re.compile(r'^[A-Za-z0-9\-]+$')
            custom_headers = [h for h in raw_headers if valid_re.match(h)]
            skipped = len(raw_headers) - len(custom_headers)
            if not custom_headers:
                print(f"[!] Wordlist '{args.wordlist}' has no valid headers.", file=sys.stderr)
                sys.exit(1)
            msg = f"[*] Loaded {len(custom_headers)} headers from {args.wordlist}"
            if skipped:
                msg += f" (skipped {skipped} invalid)"
            if not args.quiet and not args.json:
                print(style.gray(msg), file=sys.stderr)
        except FileNotFoundError:
            print(f"[!] Wordlist file not found: {args.wordlist}", file=sys.stderr)
            sys.exit(1)

    if args.proxy:
        import urllib3
        urllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)
        session.proxies = {"http": args.proxy, "https": args.proxy}
        session.verify  = False
        if not args.quiet and not args.json:
            print(style.gray(f"[*] Proxy enabled: {args.proxy}"), file=sys.stderr)

    if sys.stdin.isatty():
        print(style.yellow("Usage: echo 'https://site.com/page' | ifcp"), file=sys.stderr)
        print(style.yellow("       cat urls.txt | ifcp -H 'Cookie: session=abc'"), file=sys.stderr)
        print(style.yellow("       cat urls.txt | ifcp -j > findings.jsonl"), file=sys.stderr)
        sys.exit(1)

    results = []
    tested  = 0
    vulnerable_hosts = set()

    for line in sys.stdin:
        url = line.strip()
        if url and url.startswith('http'):
            try:
                host = urlparse(url).netloc
            except Exception:
                host = url

            if args.unique and host in vulnerable_hosts:
                continue

            tested += 1
            if args.verbose:
                print(f"[*] [{tested}] Testing: {url}", file=sys.stderr)

            current_findings = []

            finding = check_cache_poisoning(
                url, headers, args.timeout, session, custom_headers, verbose=args.verbose
            )
            if finding:
                current_findings.extend(finding)

            if args.url_normalization:
                norm_finding = check_url_normalization(
                    url, headers, args.timeout, session, verbose=args.verbose
                )
                if norm_finding:
                    current_findings.extend(norm_finding)

            if current_findings:
                if args.unique:
                    severity_order = {"HIGH": 0, "MEDIUM": 1, "LOW": 2, "UNKNOWN": 3}
                    current_findings.sort(key=lambda x: severity_order.get(x.get("severity", "UNKNOWN"), 3))
                    results.append([current_findings[0]])
                    vulnerable_hosts.add(host)
                else:
                    results.append(current_findings)

    if tested == 0:
        print("No valid URLs supplied.", file=sys.stderr)
        sys.exit(1)

    if not results:
        if args.json:
            pass  # Empty output for clean JSON Lines pipelines
        else:
            print(style.green(f"\n[-] No cache poisoning or header reflection vulnerabilities detected across {tested} URL(s)."))
    else:
        if args.json:
            render_results_json(results)
        else:
            render_results(results, style, tested)


if __name__ == '__main__':
    main()
